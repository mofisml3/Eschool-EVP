# E-School EVP — environment variables
#
# Copy to .env.local for local development overrides, or set in your
# deployment platform / CI workflow. All variables are inlined at
# build time (Vite reads VITE_* prefixed vars only) — they live in
# the JS bundle and are NOT secret.
#
# This is acceptable for the MVP single-credential demo gate. Phase 2
# replaces the mock auth service with a real backend call.

# Demo credentials (defaults: demo / demo1234)
VITE_AUTH_USERNAME=demo
VITE_AUTH_PASSWORD=demo1234

# Session lifetime in minutes (default: 60)
VITE_SESSION_TTL_MINUTES=60
